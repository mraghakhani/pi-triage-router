{
  "name": "pi-triage-router",
  "version": "0.1.0",
  "description": "Model triage for Pi: a local or remote classifier sorts each request by category and complexity, then a deterministic benchmark-and-price policy picks the execution model.",
  "keywords": ["pi-package", "pi", "router", "model-selection", "triage", "llm", "openrouter"],
  "license": "MIT",
  "type": "module",
  "author": "mraghakhani",
  "pi": {
    "extensions": ["./triage-router.ts"]
  },
  "files": [
    "triage-router.ts",
    "triage-router-lib/",
    "triage-router.json",
    "triage-router.sample.json",
    "triage-router.benchmarks.json",
    "scripts/"
  ],
  "scripts": {
    "test": "node --test tests/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@receptron/laya": "^0.1.2",
    "undici": "^8.11.2"
  },
  "allowScripts": {
    "onnxruntime-node@1.30.0": true
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.1.0",
    "@earendil-works/pi-coding-agent": "^1.1.0",
    "@types/node": "^22.20.5",
    "typescript": "5.9"
  }
}

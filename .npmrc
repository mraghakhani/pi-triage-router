# onnxruntime-node's postinstall downloads CUDA/GPU provider libraries from
# nuget.org, and linux/x64 is the only platform it does this for. That fetch
# needs direct internet access, so on a restricted or proxied network it dies
# with "socket hang up" and aborts the whole install.
#
# Safe to skip: the CPU binaries every platform needs ship inside the npm
# tarball, and Laya runs CPU inference. This is the belt for npm versions that
# ignore the allowScripts deny in package.json - npm passes unknown project
# config through to lifecycle scripts as npm_config_* env vars, which is what
# onnxruntime-node's script reads (parseInstallFlag -> process.exit(0)).
onnxruntime-node-install=skip
